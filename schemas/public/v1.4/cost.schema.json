{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aktsmm.github.io/azure-ops-pulse-demo/schemas/public/v1.4/cost.schema.json",
  "title": "Azure Ops Pulse public cost v1.4",
  "description": "Contains explicit availability, approximate JPY labels, percentage changes, and normalized trends only.",
  "type": "object",
  "required": ["current", "previous", "deltaPercent", "forecast", "budget", "normalizedTrend", "categories"],
  "$defs": {
    "periodDiagnostic": {
      "type": "object",
      "required": ["availability"],
      "properties": {
        "availability": { "enum": ["available", "unavailable"] },
        "reason": { "$ref": "./source-reason.schema.json" }
      },
      "allOf": [{
        "if": { "properties": { "availability": { "const": "available" } } },
        "then": { "properties": { "reason": false } },
        "else": { "required": ["reason"] }
      }],
      "additionalProperties": false
    },
    "amount": {
      "type": "object",
      "required": ["availability", "approximateAmount"],
      "properties": {
        "availability": { "enum": ["available", "unavailable"] },
        "approximateAmount": {
          "oneOf": [
            { "type": "string", "pattern": "^約¥" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "availability": { "const": "available" } } },
          "then": { "properties": { "approximateAmount": { "type": "string", "pattern": "^約¥" } } },
          "else": { "properties": { "approximateAmount": { "type": "null" } } }
        }
      ],
      "additionalProperties": false
    }
  },
  "properties": {
    "current": { "$ref": "#/$defs/amount" },
    "previous": { "$ref": "#/$defs/amount" },
    "periodDiagnostics": {
      "type": "object",
      "required": ["current", "previous"],
      "properties": {
        "current": { "$ref": "#/$defs/periodDiagnostic" },
        "previous": { "$ref": "#/$defs/periodDiagnostic" }
      },
      "additionalProperties": false
    },
    "deltaPercent": { "type": ["number", "null"] },
    "forecast": { "$ref": "#/$defs/amount" },
    "budget": {
      "type": "object",
      "required": ["availability", "usedPercent"],
      "properties": {
        "availability": { "enum": ["available", "unavailable"] },
        "usedPercent": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }
      },
      "allOf": [
        {
          "if": { "properties": { "availability": { "const": "available" } } },
          "then": { "properties": { "usedPercent": { "type": "number", "minimum": 0, "maximum": 100 } } },
          "else": { "properties": { "usedPercent": { "type": "null" } } }
        }
      ],
      "additionalProperties": false
    },
    "normalizedTrend": { "type": "array", "items": { "type": "number" } },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "approximateAmount", "sharePercent", "deltaPercent"],
        "properties": {
          "name": { "type": "string" },
          "approximateAmount": { "type": "string", "pattern": "^約¥" },
          "sharePercent": { "type": "number", "minimum": 0, "maximum": 100 },
          "deltaPercent": { "type": ["number", "null"] }
        },
        "allOf": [
          {
            "if": {
              "type": "object",
              "required": ["approximateAmount"],
              "properties": { "approximateAmount": { "type": "string", "pattern": "^約¥1千未満" } }
            },
            "then": { "properties": { "deltaPercent": { "type": "null" } } }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "current": { "type": "object", "properties": { "availability": { "const": "available" } } } } },
      "then": { "properties": { "periodDiagnostics": { "type": "object", "properties": { "current": { "type": "object", "properties": { "availability": { "const": "available" } } } } } } },
      "else": { "properties": { "periodDiagnostics": { "type": "object", "properties": { "current": { "type": "object", "properties": { "availability": { "const": "unavailable" } } } } } } }
    },
    {
      "if": { "properties": { "previous": { "type": "object", "properties": { "availability": { "const": "available" } } } } },
      "then": { "properties": { "periodDiagnostics": { "type": "object", "properties": { "previous": { "type": "object", "properties": { "availability": { "const": "available" } } } } } } },
      "else": { "properties": { "periodDiagnostics": { "type": "object", "properties": { "previous": { "type": "object", "properties": { "availability": { "const": "unavailable" } } } } } } }
    },
    {
      "if": {
        "type": "object",
        "required": ["current"],
        "properties": {
          "current": {
            "type": "object",
            "required": ["approximateAmount"],
            "properties": { "approximateAmount": { "type": "string", "pattern": "^約¥1千未満" } }
          }
        }
      },
      "then": { "properties": { "deltaPercent": { "type": "null" } } }
    },
    {
      "if": {
        "type": "object",
        "required": ["previous"],
        "properties": {
          "previous": {
            "type": "object",
            "required": ["approximateAmount"],
            "properties": { "approximateAmount": { "type": "string", "pattern": "^約¥1千未満" } }
          }
        }
      },
      "then": { "properties": { "deltaPercent": { "type": "null" } } }
    }
  ],
  "additionalProperties": false
}
